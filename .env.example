# EchoInsight Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to Git.

# --- LLM Provider ---
# Required. Get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Pinned model IDs (do not change without reading the ADR and updating proceedings.md)
LLM_PRIMARY_MODEL=qwen/qwen3.8-27b
LLM_VERIFIER_MODEL=openai/gpt-oss-20b

# Token budget guard (daily). Set conservatively below free-tier limit.
# Verify actual limit from x-ratelimit-* response headers on first real run.
LLM_DAILY_TOKEN_BUDGET=400000

# Concurrency cap for LLM calls (max simultaneous requests)
LLM_MAX_CONCURRENCY=3

# --- Database ---
# PostgreSQL connection string for production and integration tests
DATABASE_URL=postgresql+asyncpg://echoinsight:changeme@localhost:5432/echoinsight

# For unit tests (set automatically by test fixtures; SQLite only)
# TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# --- Application ---
# Secret key for JWT signing. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_64_char_hex_string

# JWT token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application environment: development | production | test
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Privacy ---
# Default false. When false, only redacted text is stored.
# Setting true requires application-level encryption (not implemented in MVP).
STORE_ORIGINAL_TEXT=false

# --- Features ---
# Embedding-based phrase matcher. Default false until measurably beneficial.
EMBEDDINGS_ENABLED=false

# --- Seed Users ---
# Used by scripts/seed_users.py to create initial admin and demo users.
# Comma-separated: username:password:role
SEED_USERS=admin:changeme_admin:admin,supervisor1:changeme_sup:supervisor,agent1:changeme_agent:agent

# --- CORS ---
# Allowed origins for the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Observability ---
# Prometheus metrics endpoint is always enabled at /metrics
# Set to false to disable in non-production environments
ENABLE_METRICS=true
