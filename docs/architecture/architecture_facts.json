  "data_flows": {
    "turn_append": [
      {"step": 1, "label": "HTTP POST /turns", "from": "Browser", "to": "API", "data": "speaker, text (original), idempotency_key", "deterministic": true},
      {"step": 2, "label": "JWT decode + scope check", "from": "api/deps.py", "to": "DB:users", "deterministic": true},
      {"step": 3, "label": "Idempotency check", "from": "API", "to": "DB:turns", "deterministic": true},
      {"step": 4, "label": "Redact PII (9 regex patterns)", "from": "ingest/redactor.py", "to": "text_redacted", "deterministic": true, "note": "REDACTION BOUNDARY: original text discarded here"},
      {"step": 5, "label": "Store redacted turn", "from": "API", "to": "DB:turns", "deterministic": true},
      {"step": 6, "label": "Queue per_turn_extraction job", "from": "API", "to": "DB:jobs", "deterministic": true},
      {"step": 7, "label": "Return 201 + provisional state", "from": "API", "to": "Browser", "deterministic": true}
    ],
    "per_turn_extraction": [
      {"step": 1, "label": "Poll jobs table", "from": "worker/main.py", "to": "DB:jobs", "deterministic": true},
      {"step": 2, "label": "Load turn + context", "from": "analysis/incremental.py", "to": "DB:turns", "deterministic": true},
      {"step": 3, "label": "Build SYSTEM_TURN prompt", "from": "llm/prompts.py", "to": "LLM provider", "deterministic": false, "llm": true},
      {"step": 4, "label": "Parse + validate JSON", "from": "llm/client.py", "deterministic": true},
      {"step": 5, "label": "apply_turn_extraction()", "from": "state/reducer.py", "deterministic": true, "note": "pure function: no DB access"},
      {"step": 6, "label": "Update provisional_state_json", "from": "API", "to": "DB:conversations", "deterministic": true}
    ],
    "final_analysis": [
      {"step": 1, "label": "POST /end -> queue final_analysis job", "from": "API", "to": "DB:jobs", "deterministic": true},
      {"step": 2, "label": "Worker picks job", "from": "worker/main.py", "deterministic": true},
      {"step": 3, "label": "Load all turns", "from": "analysis/pipeline.py", "to": "DB:turns", "deterministic": true},
      {"step": 4, "label": "Build transcript (format: [SPEAKER|turn_NNNN] text)", "from": "analysis/pipeline.py", "deterministic": true},
      {"step": 5, "label": "Windowed split if >40 turns", "from": "analysis/pipeline.py:_chunk_turns", "deterministic": true, "note": "window=40 turns, overlap=5 turns"},
      {"step": 6, "label": "LLM call: SYSTEM_FINAL prompt", "from": "llm/client.py", "to": "LLM provider", "llm": true, "schema": "FINAL_ANALYSIS_SCHEMA"},
      {"step": 7, "label": "D14 fix: all-neutral trajectory fallback", "from": "analysis/pipeline.py:148-171", "deterministic": true},
      {"step": 8, "label": "Evidence gate: commitments", "from": "validator/evidence_gate.py", "deterministic": true},
      {"step": 9, "label": "LLM call: SYSTEM_QA prompt", "from": "llm/client.py", "to": "LLM provider", "llm": true, "schema": "QA_SCHEMA"},
      {"step": 10, "label": "Evidence gate: QA items", "from": "validator/evidence_gate.py", "deterministic": true},
      {"step": 11, "label": "Phrase matcher augmentation (4 items)", "from": "qa/phrase_matcher.py", "deterministic": true},
      {"step": 12, "label": "Selective verification (2nd LLM call, per-item)", "from": "qa/verification.py", "to": "LLM provider", "llm": true, "model": "verifier"},
      {"step": 13, "label": "Confidence normalisation (D7 fix)", "from": "analysis/pipeline.py", "deterministic": true},
      {"step": 14, "label": "Hard gate (7 structural checks)", "from": "validator/hard_gate.py", "deterministic": true},
      {"step": 15, "label": "QA scoring: coverage, weighted score, critical cap", "from": "qa/scorer.py", "deterministic": true},
      {"step": 16, "label": "Persist Analysis + QAResult + Commitments", "from": "analysis/pipeline.py", "to": "DB:analyses,qa_results,commitments", "deterministic": true}
    ]
  },

