graph TD
    %% D0 — EchoInsight Master Architecture Poster
    %% Colorblind-safe: blue=#2E75B6 orange=#E07B39 green=#5A8A50 grey=#808080 red=#C0392B yellow=#D4AC0D
    %% Shape legend: [(rect)] = service, ([cylinder]) = store, {diamond} = decision/gate,
    %%               ((circle)) = external, >[pentagon] = LLM call

    classDef service fill:#2E75B6,stroke:#1A4A7A,color:#fff,rx:4
    classDef store fill:#5A8A50,stroke:#3A6A30,color:#fff
    classDef llmcall fill:#E07B39,stroke:#A05020,color:#fff,rx:12
    classDef deterministic fill:#2E75B6,stroke:#1A4A7A,color:#fff
    classDef gate fill:#C0392B,stroke:#8B2020,color:#fff,rx:0
    classDef external fill:#808080,stroke:#505050,color:#fff,rx:16
    classDef optional fill:#fff,stroke:#808080,color:#333,stroke-dasharray:5 5
    classDef user fill:#D4AC0D,stroke:#A07A00,color:#000,rx:24
    classDef band fill:#F0F0F0,stroke:#C0C0C0,color:#333

    %% ── USERS ──────────────────────────────────────────────────────────────
    subgraph USERS["Users & Roles"]
        direction TB
        ADMIN([Admin\nFull access]):::user
        SUP([Supervisor\nTeam-scoped]):::user
        AGENT([Agent\nOwn calls]):::user
    end

    %% ── FRONTEND ────────────────────────────────────────────────────────────
    subgraph FRONTEND["Vercel — Static React SPA"]
        direction TB
        DASH[Dashboard\nKPIs · Charts · Table]:::service
        DETAIL[Conversation Detail\nTranscript · QA · Ledger]:::service
        ADMIN_UI[Admin Panel\nChecklist · Audit · Health]:::service
        DEMO[Live Demo\nScripted simulation]:::service
        ASST_UI[Assistant UI\nChat interface]:::service
    end

    %% ── API ─────────────────────────────────────────────────────────────────
    subgraph API["Render — FastAPI + uvicorn (single instance, Docker)"]
        direction TB
        AUTHM[Auth\nJWT · argon2id · RBAC]:::deterministic
        INGEST[Ingest & Redact\n9 regex patterns\nPII → tags]:::deterministic
        REDUCER[State Reducer\npure function\nprovisional state]:::deterministic
        LEDGER[Commitment Ledger\nproposed→completed]:::deterministic
        PIPELINE[Final Analysis\nPipeline orchestrator]:::deterministic

        subgraph LLM_CALLS["LLM Calls  (redacted text only)"]
            direction LR
            LLM1>Turn Extraction\nSYSTEM_TURN]:::llmcall
            LLM2>Final Analysis\nSYSTEM_FINAL]:::llmcall
            LLM3>QA Scoring\nSYSTEM_QA]:::llmcall
            LLM4>Selective Verify\nSYSTEM_VERIFIER]:::llmcall
        end

        GATE{Evidence Gate\nexact-quote\nsubstring check}:::gate
        PHRASE[Phrase Matcher\nregex · deterministic\n4 items]:::deterministic
        SCORER[QA Scorer\ncoverage · weights\ncritical cap 60]:::deterministic
        HARDGATE{Hard Gate\n7 structural checks}:::gate
        WORKER[Background Worker\npoll every 5s]:::deterministic
        ANALYTICS[Analytics\nKPIs · Metrics]:::deterministic
        ADMIN_API[Admin API\nChecklists · Users]:::deterministic

        subgraph OPT_LAYERS["Optional Layers  (feature-flagged)"]
            direction LR
            ACTION[Action Layer\nRisk · PDCA\nflag: ACTION_LAYER_ENABLED]:::optional
            ASST_BE[Assistant\ntool-calling pipeline\nread-only]:::optional
        end
    end

    %% ── STORES ──────────────────────────────────────────────────────────────
    subgraph STORES["Data Stores"]
        direction TB
        DB[(PostgreSQL\nRender managed\n20 tables)]:::store
        SEED[(demo_seed.db\nSQLite snapshot\nrestored at boot)]:::store
        CHECKLIST[(checklist_v1.yaml\n6 items · weights\ncriticality flags)]:::store
        POLICY[(taxonomy.yaml\n14 call reasons)]:::store
    end

    %% ── EXTERNAL ────────────────────────────────────────────────────────────
    GROQ((Groq API\nOpenAI-compat\nGroq provider)):::external
    OROUTER((OpenRouter\nhigher priority\nwhen key set)):::external
    GITHUB((GitHub\nSource + CI)):::external

    %% ── FLOW EDGES ──────────────────────────────────────────────────────────
    USERS --> FRONTEND
    FRONTEND -->|HTTPS · JWT| AUTHM
    AUTHM --> INGEST
    AUTHM --> ANALYTICS
    AUTHM --> ADMIN_API
    INGEST -->|redacted text| REDUCER
    INGEST -->|store redacted\noriginal discarded| DB
    REDUCER --> LEDGER
    LEDGER --> DB
    INGEST -->|queue job| WORKER
    WORKER --> PIPELINE
    PIPELINE --> LLM2
    PIPELINE --> LLM3
    PIPELINE --> LLM4
    LLM1 -->|per-turn extraction| REDUCER
    LLM2 -->|raw output| GATE
    LLM3 -->|raw QA items| GATE
    GATE -->|verified| PHRASE
    PHRASE --> LLM4
    LLM4 -->|verification verdict| HARDGATE
    HARDGATE -->|pass| SCORER
    HARDGATE -->|fail| NEEDS_REVIEW[needs_review\nhuman flag set]:::gate
    SCORER --> DB
    ANALYTICS --> DB
    ADMIN_API --> CHECKLIST
    ADMIN_API --> DB
    DB --> FRONTEND

    LLM2 -->|redacted\ntext only| GROQ
    LLM3 -->|redacted\ntext only| GROQ
    LLM4 -->|redacted\ntext only| GROQ
    LLM1 -->|redacted\ntext only| GROQ
    GROQ -.->|higher priority| OROUTER

    SEED -.->|restored at boot\nif DB missing| DB
    CHECKLIST -.->|seeded at startup| DB
    POLICY -.->|taxonomy reference| PIPELINE

    GITHUB -.->|push → CI| API

    ACTION -.->|reads analyses| DB
    ASST_BE -.->|read-only queries| DB

    %% ── BOTTOM BANDS ────────────────────────────────────────────────────────
    subgraph TRUST["Trust & Safety"]
        TS1[Redaction boundary:\nno PII crosses to LLM]
        TS2[Evidence gate:\nhallucinated quotes blocked]
        TS3[RBAC + team scoping\nserver-enforced]
        TS4[Prompt injection defense:\nXML tags + instruction]
        TS5[Audit log\n277 entries in seed]
    end

    subgraph OBSERVABILITY["Observability & Evaluation"]
        OB1[GET /health  /ready]
        OB2[GET /metrics\nPrometheus]
        OB3[Token budget\n400k/day in-process]
        OB4[Eval pipeline\nmake eval · gold workbook]
        OB5[CI gates\nGitHub Actions]
    end

    subgraph DEPLOYMENT_BAND["Deployment"]
        DEP1[Docker · Render free tier\nsingle instance]
        DEP2[Seed restore at boot:\ndemo_seed.db → dev_local.db]
        DEP3[Alembic migrations\nrun on startup]
        DEP4[Cold start: 30-60s\nafter 15 min idle]
        DEP5[Vercel: static SPA\nfrontend/vercel.json]
    end
